  <path id="third-mobile" d="M60.0769 5.53125L98.646 21.5072L114.622 60.0769L98.646 98.646L60.0769 114.622L21.5072 98.646L5.53125 60.0769L21.5072 21.5072L60.0769 5.53125Z" fill="transparent"/>
  <path id="fourth-mobile" d="M52.9419 6.38452C57.6274 5.76766 62.374 5.76766 67.0594 6.38452C71.7449 7.00137 76.3294 8.22979 80.6958 10.0384C85.0621 11.8469 89.1721 14.2201 92.9216 17.0971C96.671 19.9741 100.027 23.3302 102.904 27.0796C105.781 30.829 108.154 34.9393 109.963 39.3056C111.771 43.6719 113 48.2564 113.617 52.942C114.234 57.6274 114.234 62.374 113.617 67.0594C113 71.7449 111.771 76.3294 109.963 80.6958C108.154 85.0621 105.781 89.1721 102.904 92.9216C100.027 96.671 96.671 100.027 92.9216 102.904C89.1721 105.781 85.0621 108.154 80.6958 109.963C76.3294 111.771 71.7449 113 67.0594 113.617C62.374 114.234 57.6274 114.234 52.942 113.617C48.2564 113 43.6719 111.771 39.3056 109.963C34.9393 108.154 30.829 105.781 27.0796 102.904C23.3302 100.027 19.9741 96.671 17.0971 92.9216C14.2201 89.1721 11.8469 85.0621 10.0384 80.6958C8.22979 76.3294 7.00137 71.7449 6.38452 67.0594C5.76766 62.374 5.76766 57.6274 6.38452 52.9419C7.00137 48.2564 8.22979 43.6719 10.0384 39.3056C11.8469 34.9393 14.2201 30.829 17.0971 27.0796C19.9741 23.3302 23.3302 19.9741 27.0796 17.0971C30.829 14.2201 34.9393 11.8469 39.3056 10.0384C43.6719 8.22979 48.2564 7.00137 52.9419 6.38452Z" fill="transparent"/>

  <div class="digit-col"><div class="digit-strip" id="strip-h"></div></div>
  <div class="digit-col"><div class="digit-strip" id="strip-t"></div></div>
  <div class="digit-col"><div class="digit-strip" id="strip-o"></div></div>
</div>

<style>
  #countup-counter .digit-col {
    width: 10px;
    height: 20px;
    overflow: hidden;
    position: relative;
  }
  #countup-counter .digit-col::before,
  #countup-counter .digit-col::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 6px;
    z-index: 2;
    pointer-events: none;
  }
  #countup-counter .digit-col::before {
    top: 0;
    background: linear-gradient(to bottom, #CF1830, transparent);
  }
  #countup-counter .digit-col::after {
    bottom: 0;
    background: linear-gradient(to top, #CF1830, transparent);
  }
  #countup-counter .digit-strip {
    position: absolute;
    left: 0; right: 0; top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #countup-counter .digit-char {
    height: 20px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: #f0ede6;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  (function() {
    const DIGIT_H = 20;
    const ONES_STEP = 5;

    function buildStrip(el, digits) {
      digits.forEach(d => {
        const span = document.createElement('div');
        span.className = 'digit-char';
        span.textContent = d;
        el.appendChild(span);
      });
    }

    const onesDigits = [];
    for (let i = 0; i < 12; i++) [0, 5].forEach(d => onesDigits.push(d));
    const tensDigits = [];
    for (let i = 0; i < 12; i++) for (let d = 0; d <= 9; d++) tensDigits.push(d);

    buildStrip(document.getElementById('strip-h'), [0, 1]);
    buildStrip(document.getElementById('strip-t'), tensDigits);
    buildStrip(document.getElementById('strip-o'), onesDigits);

    window.addEventListener('DOMContentLoaded', function() {
      const proxy = { val: 0 };
      const stripH = document.getElementById('strip-h');
      const stripT = document.getElementById('strip-t');
      const stripO = document.getElementById('strip-o');

      gsap.set([stripH, stripT, stripO], { y: 0 });

      gsap.to(proxy, {
        val: 100,
        duration: 3,
        ease: 'power2.inOut',
        onUpdate() {
          const v = proxy.val;
          gsap.set(stripH, { y: -(v / 100) * DIGIT_H });
          gsap.set(stripT, { y: -(v / 10) * DIGIT_H });
          gsap.set(stripO, { y: -(v / ONES_STEP) * DIGIT_H });
        }
      });
    });
  })();
</script></div></div><div data-w-id="d3f2c984-d25a-191e-d7bb-c0a07bde4e27" class="scissors_wrap"><img src="./images/69bd455af03722278a958711_Scisors_68ae41.png" loading="lazy" alt="White scissors icon." class="scissors"/></div><div class="line_wrap"><div data-w-id="7d4f9dcc-6549-b507-19d7-07410c128d49" class="solid_line"></div><div class="dashed_line w-embed"><svg width="2000" height="2" viewBox="0 0 2000 2" fill="none" xmlns="http://www.w3.org/2000/svg">
<line y1="1" x2="2000" y2="1" stroke="white" stroke-width="2" stroke-dasharray="8 8"/>

{
  "name": "boatship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint app components lib types scripts tests proxy.ts custom-worker.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-boatship \"node --import tsx --test tests/local-flow.e2e.mjs\"",
    "build:cloudflare": "next build --turbopack && node scripts/build-opennext.mjs --skipNextBuild && node scripts/scrub-env-bundle.mjs && node scripts/patch-cloudflare-manifests.mjs && node scripts/prune-cloudflare-assets.mjs",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && wrangler deploy --config wrangler.production.toml",
    "cf:dry-run": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e:postgres": "node --import tsx --env-file-if-exists=.env.local --test tests/local-flow.e2e.mjs",
    "test:postgres": "node --import tsx --env-file-if-exists=.env.local --test tests/firestore.test.mjs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-boatship \"node --import tsx --test tests/firestore.test.mjs\"",
    "local-qa": "firebase emulators:exec --only firestore --project demo-boatship \"node --import tsx scripts/local-qa.mjs\"",
    "firestore:indexes": "node --import tsx scripts/firestore-indexes.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/react": "^4.0.96",
    "@composio/core": "^0.18.1",
    "@composio/vercel": "^0.12.0",
    "@opentelemetry/api": "^1.9.1",
    "ai": "^7.0.93",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}

{
  "name": "boatship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint app components lib types scripts tests proxy.ts custom-worker.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deploy-migrations.mjs",
    "db:import-local": "node scripts/import-local-store.mjs",
    "build:cloudflare": "next build --turbopack && opennextjs-cloudflare build --skipNextBuild && node scripts/prune-cloudflare-assets.mjs && node scripts/copy-server-wasm.mjs",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run db:deploy && npm run build:cloudflare && wrangler deploy --config wrangler.production.toml",
    "cf:dry-run": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/react": "^4.0.96",
    "@composio/core": "^0.18.1",
    "@composio/vercel": "^0.12.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^6.16.2",
    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "ai": "^7.0.93",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}

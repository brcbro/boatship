# Boatship Client Onboarding — Environment

# Firebase Client (optional — local demo mode works without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (optional)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (optional — emails log to console in demo mode)
RESEND_API_KEY=
RESEND_FROM=Boatship Onboarding <onboarding@resend.dev>

# Composio (optional — Integrations page works in setup mode without this)
COMPOSIO_API_KEY=
# Slack channel id or name for auto-notify on onboarding events (e.g. #onboarding or C01234567)
COMPOSIO_SLACK_CHANNEL=
# Optional parent Drive folder ID for auto-provisioned client folders (defaults to My Drive root)
# COMPOSIO_DRIVE_PARENT_FOLDER_ID=

# Drive Agent LLM (required for /agent chat — OpenRouter, OpenAI direct, or Vercel AI Gateway)
# OpenRouter is preferred when set. The free router selects an available tool-capable free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-4o-mini
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

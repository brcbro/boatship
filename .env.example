# Boatship local environment template
# Keep this file's variable names aligned with .env.local. Replace placeholders locally.

# Neon Postgres + Prisma
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT.neon.tech/neondb?sslmode=require"

# Composio integrations
COMPOSIO_API_KEY="your-composio-api-key"

# Required for hosted email invitations, resets, and notifications.
# ZEPTOMAIL_API_KEY="your-zeptomail-send-api-key"
# ZEPTOMAIL_FROM="verified-sender@cohortix.in"
# Alternative provider:
# RESEND_API_KEY="your-resend-api-key"
# RESEND_FROM="Boatship <verified@your-domain.example>"

# Hodi agent
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openrouter/free"
BOATSHIP_SECRETS_MASTER_KEY="generate-a-32-byte-hex-or-base64-key"

# Optional shared cache (Upstash Redis REST; works on Cloudflare Workers)
# REDIS_REST_URL="https://YOUR-REDIS.upstash.io"
# REDIS_REST_TOKEN="your-upstash-rest-token"

# Live message WebSocket ticket signing key (use a long random value)
# MESSAGE_REALTIME_SECRET="generate-a-long-random-secret"

# Required for deployed webhook retry and product reminder cron jobs.
# BOATSHIP_CRON_SECRET="generate-a-long-random-secret"

# Exact HTTPS origins allowed for outbound webhooks, comma-separated.
# Empty/unset disables new webhook destinations and delivery.
# WEBHOOK_ALLOWED_ORIGINS="https://hooks.example.com,https://automation.example.org"
